
# ==========================================
# ASL Sign Language Recognition Project
# ==========================================

# Python virtual environments
.venv/
venv/
env/

# Python cache files
__pycache__/
*.py[cod]
*.pyo

# Python packaging
*.egg-info/
build/
dist/

# Environment variables and secrets
.env
.env.*
!.env.example

# VS Code and IDE files
.vscode/
.idea/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# ==========================================
# DATASETS
# ==========================================

# Ignore downloaded datasets and generated CSVs
dataset/*
!dataset/.gitkeep

# ==========================================
# TRAINED MODELS
# ==========================================

# Ignore large model weights
*.keras
*.h5
*.hdf5
*.onnx
*.pth
*.pt
*.tflite
*.task

# ==========================================
# TRAINING OUTPUTS
# ==========================================

# Generated normalization and NumPy files
*.npy
*.npz

# Logs and checkpoints
logs/
checkpoints/
runs/
tensorboard/
*.log

# ==========================================
# SYSTEM FILES
# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
